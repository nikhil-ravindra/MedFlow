"""
app.py - the MedFlow app: a multi-page Streamlit dashboard.

Owner: Dwijesh.   Run:  streamlit run app.py

Pages (top navigation bar):
  Home              - project intro, team, big "Start simulation" button
  Setup             - arrivals, hospital resources, strategy, scenarios
  Live simulation   - key numbers, charts, time travel, maths check
  Patients          - every patient with the AI's urgency level and reason
  Compare           - all 4 strategies on the same patients
  AI triage         - type a complaint, the AI classifies it live
"""

import pandas as pd
import plotly.express as px
import streamlit as st

from config import DEFAULT_RESOURCES, ESI, RESOURCE_TYPES, SIM_DEFAULTS
from metrics import compare_strategies, compute_metrics, patient_table
from sim import load_patient_pool, prepare_run, run_simulation
from strategies import STRATEGIES
from triage import TriageError, triage

st.set_page_config(page_title="MedFlow", page_icon="🏥", layout="wide")

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
TEAM = [
    ("Vansh", "Simulation engine", "⚙️"),
    ("Om", "Strategies & statistics", "📐"),
    ("Dwijesh", "Dashboard & UI", "🖥️"),
    ("Nikhil", "AI triage & data", "🤖"),
]
OURS = "Urgency + waiting time (ours)" if "Urgency + waiting time (ours)" in STRATEGIES else list(STRATEGIES)[0]
STRATEGY_HELP = {
    "First come, first served": "Whoever arrives first is treated first.",
    "Urgency only": "Most urgent patient first, always.",
    "Urgency + waiting time (ours)": "Critical patients (ESI 1–2) first, then whoever is most overdue for their target wait.",
    "Urgency + shortest job first": "Most urgent first, then the quickest treatment.",
}
ESI_DOTS = {1: "🔴", 2: "🟠", 3: "🟡", 4: "🟢", 5: "🟩"}
ESI_COLORS = {f"ESI {k}": v["color"] for k, v in ESI.items()}
RESOURCE_LABELS = {"bed": "Beds", "icu_bed": "ICU beds", "doctor": "Doctors", "nurse": "Nurses"}
RESOURCE_ICONS = {"bed": "🛏️", "icu_bed": "❤️‍🩹", "doctor": "🩺", "nurse": "💉"}
SCENARIOS = {
    "surge": ("🚨 Emergency surge", "3× arrivals for 2 hours"),
    "ambulances": ("🚑 Ambulance arrivals", "+2 critical patients per hour"),
    "staff_shortage": ("👩‍⚕️ Staff shortage", "2nd half: −2 doctors, −3 nurses"),
    "resource_failure": ("🔧 Equipment failure", "−3 beds, −1 ICU bed for 90 min"),
}
EXAMPLES = [
    "Crushing chest pain spreading to left arm, sweating, BP 90/60",
    "Severe headache, blurred vision, BP 190/110, age 58",
    "Twisted ankle playing football, can walk with a limp",
    "Needs a refill of blood pressure tablets, feels fine",
]
PLOT = "plotly_white"

DEFAULT_CFG = {
    "rate": SIM_DEFAULTS["rate_per_hour"],
    "hours": SIM_DEFAULTS["sim_hours"],
    "seed": 42,
    "strategy": OURS,
    **{k: False for k in SCENARIOS},
    **{f"res_{r}": DEFAULT_RESOURCES[r] for r in RESOURCE_TYPES},
}

