# ---------------------------------------------------------------------------
# Shared state + helpers
# ---------------------------------------------------------------------------
if "cfg" not in st.session_state:
    st.session_state.cfg = dict(DEFAULT_CFG)


@st.cache_data
def get_pool():
    return load_patient_pool()


def pool_or_error():
    try:
        return get_pool(), None
    except (FileNotFoundError, ValueError) as e:
        return None, str(e)


def run_sim():
    """Run the simulation with the current Setup settings and store the results."""
    cfg = st.session_state.cfg
    pool, error = pool_or_error()
    if error:
        st.error(error)
        return False
    settings = {"rate_per_hour": cfg["rate"], "sim_hours": cfg["hours"], **{k: cfg[k] for k in SCENARIOS}}
    resources = {r: cfg[f"res_{r}"] for r in RESOURCE_TYPES}
    with st.spinner("Simulating the hospital with all 4 strategies..."):
        patients, events, sim_minutes, surge = prepare_run(pool, settings, cfg["seed"])
        results = run_simulation(patients, resources, cfg["strategy"], sim_minutes, events)
        comparison, _ = compare_strategies(patients, resources, sim_minutes, events)
    st.session_state.run = {
        "results": results, "metrics": compute_metrics(results), "comparison": comparison,
        "events": events, "surge": surge, "settings": settings, "strategy": cfg["strategy"],
    }
    st.session_state.pop("ai_summary", None)
    return True


def need_run():
    """Shown on result pages before anything has been simulated."""
    st.info("No simulation yet. Choose your settings on **Setup**, or run with the current settings now.")
    if st.button("▶ Run simulation", type="primary"):
        if run_sim():
            st.rerun()


def scenario_chips(run):
    active = [SCENARIOS[k][0] for k in SCENARIOS if run["settings"].get(k)] or ["🟢 Normal day"]
    chips = "".join(f"<span class='chip'>{c}</span>" for c in active)
    st.markdown(f"<span class='chip'>🧠 {run['strategy']}</span>{chips}", unsafe_allow_html=True)


def shade(fig, run):
    """Shade the surge and event windows on a time chart."""
    if run["surge"]:
        fig.add_vrect(x0=run["surge"]["start"], x1=run["surge"]["end"], fillcolor="red",
                      opacity=0.08, line_width=0, annotation_text="surge")
    seen = set()
    for e in run["events"]:
        if e["name"] not in seen:
            seen.add(e["name"])
            fig.add_vrect(x0=e["start"], x1=e["end"], fillcolor="gray", opacity=0.08,
                          line_width=0, annotation_text=e["name"].lower())
    return fig


def card(icon, title, text, num=""):
    num_html = f"<div class='num'>{num}</div>" if num else ""
    return f"<div class='card'>{num_html}<div class='icon'>{icon}</div><h4>{title}</h4><p>{text}</p></div>"


# ---------------------------------------------------------------------------
# Page: Home
# ---------------------------------------------------------------------------
def page_home():
    st.markdown("""
    <div class="hero">
      <span class="badge">HACK-A-MATICS 2026 &nbsp;·&nbsp; THEME: VECTOR</span>
      <h1>🏥 MedFlow</h1>
      <div class="tag">Prioritize patients. Optimize resources.</div>
      <p>An AI triage nurse and a minute-by-minute hospital simulation that finds the fairest,
      safest way to share beds, ICU beds, doctors and nurses when patients arrive at random.</p>
    </div>
    """, unsafe_allow_html=True)

    left, mid, right = st.columns([1, 2, 1])
    with mid:
        if st.button("▶  Start simulation", type="primary", width="stretch"):
            if run_sim():
                st.switch_page(live_page)
        cfg = st.session_state.cfg
        st.caption(f"Runs {cfg['rate']} patients/hour for {cfg['hours']} hours with "
                   f"“{cfg['strategy']}”. Change this on the **Setup** page.")

    st.markdown("<div class='section'>How it works</div>", unsafe_allow_html=True)
    steps = [
        ("🤖", "AI triage", "Gemini reads each patient's complaint and assigns an urgency level (ESI 1–5) and the resources they need."),
        ("🎲", "Random arrivals", "Patients arrive at random times following a Poisson process, like a real emergency room."),
        ("⏱️", "Live simulation", "Every minute: discharge, arrivals, then assign beds and staff, all-or-nothing, never over capacity."),
        ("⚖️", "Fair comparison", "Four scheduling strategies are replayed on the same patients to see which works best."),
    ]
    for col, (icon, title, text), n in zip(st.columns(4), steps, range(1, 5)):
        col.markdown(card(icon, title, text, f"STEP {n}"), unsafe_allow_html=True)

    st.markdown("<div class='section'>Our team</div>", unsafe_allow_html=True)
    for col, (name, role, icon) in zip(st.columns(4), TEAM):
        col.markdown(card(icon, name, role), unsafe_allow_html=True)

    st.markdown("<div class='footer'>Built for Hack-a-Matics 2026 · Pentagram, the Mathematical Society of BMSCE × "
                "BMSCE IEEE Computer Society · Problem statement: MedFlow</div>", unsafe_allow_html=True)


# ---------------------------------------------------------------------------
# Page: Setup
# ---------------------------------------------------------------------------
def page_setup():
    cfg = st.session_state.cfg
    # Widgets use "w_" keys; seed them from cfg so settings survive page changes.
    for k, v in cfg.items():
        st.session_state.setdefault(f"w_{k}", v)

    st.title("⚙️ Setup")
    st.caption("Design your hospital and the day you want to simulate.")

    c1, c2, c3 = st.columns(3)
    with c1.container(border=True):
        st.subheader("👥 Patient arrivals")
        st.slider("Walk-in patients per hour", 1, 20, key="w_rate")
        st.slider("Hours to simulate", 4, 24, key="w_hours")
        st.number_input("Random seed (same seed = same patients)", 0, 9999, key="w_seed")
    with c2.container(border=True):
        st.subheader("🏥 Hospital resources")
        for r in RESOURCE_TYPES:
            st.slider(f"{RESOURCE_ICONS[r]} {RESOURCE_LABELS[r]}", 0, DEFAULT_RESOURCES[r] * 3, key=f"w_res_{r}")
    with c3.container(border=True):
        st.subheader("🧠 Strategy & scenarios")
        st.selectbox("Scheduling strategy", list(STRATEGIES), key="w_strategy")
        st.caption(STRATEGY_HELP.get(st.session_state.w_strategy, ""))
        for k, (label, help_text) in SCENARIOS.items():
            st.toggle(label, key=f"w_{k}", help=help_text)

    for k in cfg:
        cfg[k] = st.session_state[f"w_{k}"]

    b1, b2, _ = st.columns([2, 1, 3])
    if b1.button("▶ Run simulation", type="primary", width="stretch"):
        if run_sim():
            st.switch_page(live_page)
    if b2.button("↺ Reset", width="stretch"):
        st.session_state.cfg = dict(DEFAULT_CFG)
        for k in DEFAULT_CFG:
            st.session_state.pop(f"w_{k}", None)
        st.rerun()


# ---------------------------------------------------------------------------
# Page: Live simulation
# ---------------------------------------------------------------------------
def page_live():
    st.title("📊 Live simulation")
    run = st.session_state.get("run")
    if not run:
        need_run()
        return
    results, m = run["results"], run["metrics"]
    s = m["summary"]
    scenario_chips(run)

    c1, c2, c3, c4, c5 = st.columns(5)
    c1.metric("Patients arrived", s["patients"], border=True)
    c2.metric("Treated", s["treated"], f"{s['still_waiting']} still waiting", delta_color="off", delta_arrow="off", border=True)
    c3.metric("Average wait", f"{s['avg_wait']:.0f} min", border=True)
    c4.metric("Seen on time", f"{s['pct_on_time']:.0f}%", border=True)
    c5.metric("Longest queue", s["max_queue"], border=True)

    with st.container(border=True):
        a, b = st.columns([1, 3])
        if a.button("🤖 Explain these results (AI)", width="stretch"):
            try:
                from ai_assistant import summarize
                with st.spinner("Asking the AI analyst..."):
                    st.session_state.ai_summary = summarize(m, run["settings"], run["strategy"], run["events"])
            except Exception as e:  # show the problem honestly, never fake an answer
                st.session_state.ai_summary = f"⚠️ AI unavailable: {e}"
        b.write(st.session_state.get("ai_summary") or
                "Ask Gemini to find the bottleneck and suggest one improvement.")

    t_queue, t_res, t_time, t_math = st.tabs(["📈 Queue", "🛏️ Resources", "⏱ Time travel", "🧮 Maths check"])

    with t_queue:
        timeline = pd.DataFrame([{"minute": x["t"], "waiting": x["queue_len"], "being treated": x["treating"]}
                                 for x in results["timeline"]])
        fig = px.line(timeline, x="minute", y=["waiting", "being treated"], template=PLOT,
                      labels={"value": "patients", "variable": ""},
                      title="Patients waiting vs being treated",
                      color_discrete_sequence=["#D62728", "#0B6E6E"])
        st.plotly_chart(shade(fig, run), width="stretch")

    with t_res:
        cols = st.columns(len(RESOURCE_TYPES))
        for col, r in zip(cols, RESOURCE_TYPES):
            col.metric(f"{RESOURCE_ICONS[r]} {RESOURCE_LABELS[r]} avg busy", f"{m['utilisation'][r]:.0f}%", border=True)
        rows = []
        for x in results["timeline"]:
            for r in RESOURCE_TYPES:
                cap = x["capacity"][r]
                rows.append({"minute": x["t"], "resource": RESOURCE_LABELS[r],
                             "busy %": 100 * x["used"][r] / cap if cap else 0})
        fig = px.line(pd.DataFrame(rows), x="minute", y="busy %", color="resource", template=PLOT,
                      title="Resource utilisation over time (100% = full)")
        fig.add_hline(y=100, line_dash="dash", line_color="gray")
        st.plotly_chart(shade(fig, run), width="stretch")

    with t_time:
        minute = st.slider("Look inside the hospital at minute", 0, results["sim_minutes"] - 1,
                           results["sim_minutes"] // 2)
        snap = results["timeline"][minute]
        cols = st.columns(len(RESOURCE_TYPES))
        for col, r in zip(cols, RESOURCE_TYPES):
            col.metric(f"{RESOURCE_ICONS[r]} {RESOURCE_LABELS[r]}",
                       f"{snap['used'][r]} / {snap['capacity'][r]}", "in use", delta_color="off", delta_arrow="off", border=True)
        waiting = [
            {"ESI": f"{ESI_DOTS[p['esi']]} {p['esi']}", "id": p["id"], "complaint": p["complaint"],
             "waiting for (min)": minute - p["arrival_time"]}
            for p in results["patients"]
            if p["arrival_time"] <= minute and (p["start_time"] is None or p["start_time"] > minute)
        ]
        st.write(f"**{len(waiting)} patients waiting at minute {minute}** (hour {minute / 60:.1f})")
        if waiting:
            st.dataframe(pd.DataFrame(waiting).sort_values("ESI"), hide_index=True, width="stretch")

    with t_math:
        ll = m["littles_law"]
        st.markdown("Queueing theory's **Little's law** says **L = λ × W**: "
                    "average number waiting = arrival rate × average wait.")
        c1, c2, c3, c4 = st.columns(4)
        c1.metric("λ (arrivals / min)", f"{ll['lambda']:.3f}", border=True)
        c2.metric("W (avg wait, min)", f"{ll['W']:.1f}", border=True)
        c3.metric("Predicted L = λ × W", f"{ll['L_predicted']:.2f}", border=True)
        c4.metric("Measured queue length", f"{ll['L_measured']:.2f}", border=True)
        st.success("They match, which shows the simulation keeps count correctly.")


# ---------------------------------------------------------------------------
# Page: Patients
# ---------------------------------------------------------------------------
def page_patients():
    st.title("🧑‍⚕️ Patients")
    run = st.session_state.get("run")
    if not run:
        need_run()
        return
    df = patient_table(run["results"])
    scenario_chips(run)

    cols = st.columns(5)
    for col, e in zip(cols, ESI):
        sub = df[df["esi"] == e]
        col.metric(f"{ESI_DOTS[e]} ESI {e} · {ESI[e]['name']}", len(sub),
                   f"avg wait {sub['wait'].mean():.0f} min" if len(sub) else "—", delta_color="off", delta_arrow="off", border=True)

    f1, f2 = st.columns([3, 1])
    levels = f1.multiselect("Urgency levels", list(ESI), default=list(ESI),
                            format_func=lambda e: f"{ESI_DOTS[e]} ESI {e}")
    status = f2.selectbox("Status", ["All", "Treated", "Still waiting"])
    view = df[df["esi"].isin(levels)]
    if status != "All":
        view = view[view["treated"] == (status == "Treated")]

    show = view.assign(
        ESI=view["esi"].map(lambda e: f"{ESI_DOTS[e]} {e}"),
        status=view["treated"].map({True: "✅ treated", False: "⏳ waiting"}),
        on_time=view["on_time"].map({True: "✔", False: "✘"}),
    )[["id", "ESI", "source", "complaint", "ai_reason", "arrival_time", "start_time", "wait", "on_time", "status"]]
    st.dataframe(show, hide_index=True, width="stretch", height=380,
                 column_config={"ai_reason": st.column_config.TextColumn("AI reason", width="large"),
                                "wait": st.column_config.NumberColumn("wait (min)")})

    box = df.assign(level=df["esi"].map(lambda e: f"ESI {e}")).sort_values("esi")
    fig = px.box(box, x="level", y="wait", color="level", color_discrete_map=ESI_COLORS, points="all",
                 template=PLOT, title="Waiting time by urgency level (minutes)")
    fig.update_layout(showlegend=False)
    st.plotly_chart(fig, width="stretch")


# ---------------------------------------------------------------------------
# Page: Compare strategies
# ---------------------------------------------------------------------------
def page_compare():
    st.title("⚖️ Compare strategies")
    run = st.session_state.get("run")
    if not run:
        need_run()
        return
    comp = run["comparison"]
    scenario_chips(run)
    st.caption("All four strategies were replayed on **exactly the same patients**, so the comparison is fair.")

    # Key takeaways, computed from the table (not hardcoded)
    max_cols = [f"ESI {e} max wait" for e in ESI if f"ESI {e} max wait" in comp]
    rows = comp.set_index("strategy")
    worst = rows[max_cols].max(axis=1)
    k1, k2, k3 = st.columns(3)
    if "First come, first served" in rows.index and "ESI 1 avg wait" in rows and pd.notna(rows.loc[OURS, "ESI 1 avg wait"]):
        k1.metric("🔴 ESI 1 avg wait: ours vs first-come",
                  f"{rows.loc[OURS, 'ESI 1 avg wait']:.0f} min",
                  f"{rows.loc[OURS, 'ESI 1 avg wait'] - rows.loc['First come, first served', 'ESI 1 avg wait']:+.0f} min",
                  delta_color="inverse", border=True)
    if "Urgency only" in worst.index:
        k2.metric("⏳ Worst wait: ours vs urgency-only", f"{worst[OURS]:.0f} min",
                  f"{worst[OURS] - worst['Urgency only']:+.0f} min", delta_color="inverse", border=True)
    best = rows["pct_on_time"].idxmax()
    k3.metric("✅ Most patients seen on time", f"{rows.loc[best, 'pct_on_time']:.0f}%", best, delta_color="off", delta_arrow="off", border=True)

    styled = comp.style.apply(
        lambda r: ["background-color: #E6F4F1; font-weight: 600" if r["strategy"] == OURS else "" for _ in r], axis=1
    ).format(precision=1)
    st.dataframe(styled, hide_index=True, width="stretch")

    t1, t2, t3 = st.tabs(["Average wait", "Worst-case wait (fairness)", "% seen on time"])
    with t1:
        cols = [f"ESI {e} avg wait" for e in ESI]
        long = comp.melt(id_vars="strategy", value_vars=cols, var_name="level", value_name="avg wait (min)")
        long["level"] = long["level"].str.replace(" avg wait", "")
        st.plotly_chart(px.bar(long, x="level", y="avg wait (min)", color="strategy", barmode="group",
                               template=PLOT, title="Average wait per urgency level"), width="stretch")
    with t2:
        long = comp.melt(id_vars="strategy", value_vars=max_cols, var_name="level", value_name="max wait (min)")
        long["level"] = long["level"].str.replace(" max wait", "")
        st.plotly_chart(px.bar(long, x="level", y="max wait (min)", color="strategy", barmode="group",
                               template=PLOT, title="Worst-case wait per urgency level"), width="stretch")
    with t3:
        fig = px.bar(comp, x="strategy", y="pct_on_time", color="strategy", template=PLOT,
                     title="% of patients seen within their target time")
        fig.update_layout(showlegend=False)
        st.plotly_chart(fig, width="stretch")


# ---------------------------------------------------------------------------
# Page: AI triage
# ---------------------------------------------------------------------------
def page_ai():
    st.title("🤖 AI triage nurse")
    st.caption("Type any patient complaint. Google Gemini assigns an urgency level (ESI 1–5) and the resources needed, live.")

    left, right = st.columns([1, 1], gap="large")
    with left:
        example = st.selectbox("Try an example", ["(type your own)"] + EXAMPLES)
        default = "" if example == "(type your own)" else example
        text = st.text_area("Patient complaint and vital signs", value=default, height=120,
                            placeholder="e.g. Chest pain for 1 hour, sweating, BP 150/95")
        go = st.button("🩺 Triage with AI", type="primary", width="stretch")
        st.caption("Each click uses 1 request from the free Gemini quota.")
    with right:
        if go and not text.strip():
            st.session_state.triage_result = None
            st.warning("Type a complaint first, or pick an example.")
        elif go:
            try:
                with st.spinner("Asking the AI..."):
                    st.session_state.triage_result = triage(text, use_cache=False)
            except TriageError as e:
                st.session_state.triage_result = {"error": str(e)}
        r = st.session_state.get("triage_result")
        if not r:
            st.info("The AI's decision will appear here.")
        elif "error" in r:
            st.error(f"AI unavailable: {r['error']}")
        else:
            info = ESI[r["esi"]]
            st.markdown(f"<div class='result' style='background:{info['color']}'>"
                        f"<h2>{ESI_DOTS[r['esi']]} ESI {r['esi']} — {info['name']}</h2>"
                        f"Should be seen within <b>{info['target_wait']} min</b></div>", unsafe_allow_html=True)
            st.write("")
            st.write(f"**Reason:** {r['reason']}")
            needs = ", ".join(f"{RESOURCE_ICONS[k]} {n} × {RESOURCE_LABELS[k]}" for k, n in r["needs"].items() if n)
            st.write(f"**Resources needed:** {needs}")
            st.caption(f"Complaint: “{r.get('complaint', '')}” · Model: {r['model']}")

    st.markdown("<div class='section'>What do the ESI levels mean?</div>", unsafe_allow_html=True)
    st.dataframe(pd.DataFrame([
        {"ESI": f"{ESI_DOTS[k]} {k}", "name": v["name"], "example": v["example"],
         "target wait (min)": v["target_wait"],
         "treatment (min)": f"{v['treatment_minutes'][0]}–{v['treatment_minutes'][1]}"}
        for k, v in ESI.items()
    ]), hide_index=True, width="stretch")


# ---------------------------------------------------------------------------
# Navigation
# ---------------------------------------------------------------------------
home_page = st.Page(page_home, title="Home", icon="🏠", default=True)
setup_page = st.Page(page_setup, title="Setup", icon="⚙️", url_path="setup")
live_page = st.Page(page_live, title="Live simulation", icon="📊", url_path="live")
patients_page = st.Page(page_patients, title="Patients", icon="🧑‍⚕️", url_path="patients")
compare_page = st.Page(page_compare, title="Compare", icon="⚖️", url_path="compare")
ai_page = st.Page(page_ai, title="AI triage", icon="🤖", url_path="ai-triage")

st.navigation([home_page, setup_page, live_page, patients_page, compare_page, ai_page],
              position="top").run()
